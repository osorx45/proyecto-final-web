# Copia este archivo como ".env" y llena los valores. El .env nunca se sube a GitHub.

# ===================== PRODUCCIÓN (docker-compose.yml) =====================

# Subdominios, sin https:// (ejemplo: bic.midominio.com y api-bic.midominio.com)
FRONTEND_DOMAIN=
BACKEND_DOMAIN=

# Cadena de conexión de MongoDB Atlas (base de datos externa).
MONGO_URI=

# Clave privada para firmar los JWT. Usa un texto largo y aleatorio.
JWT_SECRET=

# Primer administrador (se crea con: docker compose exec backend npm run seed:admin)
ADMIN_NUMERO=1
ADMIN_PASSWORD=
ADMIN_EMAIL=

# (Opcional) Firebase para "Entrar con Google". Vacío = sin botón de Google.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# ================= DESARROLLO (docker-compose.dev.yml) =====================
# Solo para el MongoDB local en Docker.
MONGO_ROOT_PASSWORD=
BIC_DB_PASSWORD=
