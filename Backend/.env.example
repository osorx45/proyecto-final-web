# Copia este archivo como ".env" y llena los valores (desarrollo local).

PORT=3000
NODE_ENV=development

# Conexión a MongoDB: el Mongo local de Docker o la cadena de MongoDB Atlas.
MONGO_URI=

# Clave privada para firmar y verificar los JWT.
JWT_SECRET=

# Dirección del Frontend (CORS). Varias direcciones se separan con coma.
CLIENT_URL=http://localhost:5173

# Primer administrador (npm run seed:admin).
ADMIN_NUMERO=1
ADMIN_PASSWORD=
# Opcional: correo de Google del administrador.
ADMIN_EMAIL=

# Opcional: id del proyecto de Firebase para "Entrar con Google".
FIREBASE_PROJECT_ID=
